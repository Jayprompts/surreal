NODE_ENV=development
PORT=4300
# The API's own login: a member of the least-privilege surreal_api role (create it with `npm run db:local-user`).
# Local-only values below; production values live only on the VPS.
DATABASE_URL=postgresql://surreal_api_local:local_dev_only@127.0.0.1:54322/postgres
# Admin login, used only to apply migrations and create the local API login (the local Supabase default).
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The website's address (CORS). Next.js dev server arrives in Phase 4.
WEB_URL=http://localhost:3000
# Supabase project URL (local: `npx supabase status` → API URL). Only public keys are fetched from it.
SUPABASE_URL=http://127.0.0.1:54321

# Licence key secrets. Generate your own locally (never reuse them in production, never change production's):
#   openssl rand -base64 48   → KEY_HASH_SECRET
#   openssl rand -base64 32   → KEY_ENCRYPTION_KEY
KEY_HASH_SECRET=
KEY_ENCRYPTION_KEY=
# Outgoing email. Local: Supabase's Mailpit (see the emails at http://127.0.0.1:54324).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Surreal <no-reply@surreal.local>
