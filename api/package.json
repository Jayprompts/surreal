{
  "name": "@surreal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "db:migrate:prod": "node --env-file=.env dist/scripts/migrate.js",
    "db:local-user": "tsx --env-file=.env src/scripts/db-local-user.ts",
    "db:check": "tsx --env-file=.env src/scripts/db-check.ts",
    "db:studio": "drizzle-kit studio",
    "make-owner": "tsx --env-file=.env src/scripts/make-owner.ts",
    "make-owner:prod": "node --env-file=.env dist/scripts/make-owner.js"
  },
  "dependencies": {
    "@surreal/shared": "^0.1.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.11",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
