{
  "name": "surreal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "api",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
