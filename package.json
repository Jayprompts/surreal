{
  "name": "surreal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "api"
  ],
  "scripts": {
    "dev:api": "npm run build -w @surreal/shared && npm run dev -w api",
    "build": "npm run build -w @surreal/shared && npm run build -w api",
    "typecheck": "npm run build -w @surreal/shared && npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:local-user": "npm run db:local-user -w api",
    "db:check": "npm run db:check -w api",
    "db:studio": "npm run db:studio -w api",
    "make-owner": "npm run make-owner -w api --"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
