# Public values (sent to the browser). Local: `npx supabase status` → API URL and Publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Where the website's server talks to our API (never exposed to the browser).
API_URL=http://localhost:4300
# Optional: the Windows installer link. Without it, Download shows "coming with the closed test".
# NEXT_PUBLIC_DOWNLOAD_URL=
